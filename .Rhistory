sites_elevation = read_csv('data/validation/2025_records-2311298/MOJN_IU_SOP07_SiteEstablishment_Data.csv', show_col_types = FALSE) %>%
select(SiteCode, Elevation_m) %>%
rename(Site = SiteCode)
#officially released data from 2024 monitoring
counts_adults_juveniles_2024 = read_csv('data/validation/2025_records-2311298/MOJN_IU_SOP15_Density_Data.csv', show_col_types = FALSE) %>%
filter(USDACode == 'YUBR') %>%
mutate(Year = 2024) %>% #plot size is one ha from data
group_by(Site, Park, SurveyClass) %>%
summarize(CountLive = sum(CountLive)) %>%
pivot_wider(names_from = 'SurveyClass', values_from = CountLive) %>%
mutate(Density_Adults_km = Tree*400,
Density_Saplings_km = Sapling*400*10,
Density_Seedlings_km = Seedling*400*50/3) %>%
mutate(r_J = Density_Saplings_km/Density_Adults_km,
r_S = Density_Seedlings_km/Density_Adults_km) %>%
pivot_longer(cols = c('Density_Adults_km', 'Density_Saplings_km', 'Density_Seedlings_km'),
names_to = 'Age_Class', values_to = 'Density_km')
counts_adults_juveniles_2015 = read_csv('data/validation/MOJN_IU_2020_Redacted/Data_Redacted/TreeCount.csv', show_col_types = FALSE) %>%
filter(Species == 'YUBR', Dead == 0) %>%
mutate(Year = year(as.Date(Event_Date, format = "%m/%d/%Y %H:%M:%S")),
Density_km = Tree_Count*100) %>%
rename(Site = Loc_Name, Park = Unit_Code) %>%
select(Site, Park, Year, Density_km, Age_Class)
ggplot() + theme_bw() +
geom_jitter(data = counts_adults_juveniles_2024[counts_adults_juveniles_2024$Park == 'JOTR', ], aes(x = Age_Class, y = Density_km, color = Park), width = 0.2, height = 0) +
scale_y_continuous(name = 'Density in trees per km2') +
scico::scale_color_scico_d(palette = 'bamako', begin = .3, end = .7)
ggplot() + theme_bw() +
geom_jitter(data = counts_adults_juveniles_2015[counts_adults_juveniles_2015$Park == 'JOTR', ], aes(x = Age_Class, y = Density_km, color = Park), width = 0.2, height = 0) +
scale_y_continuous(name = 'Density in trees per km2') +
scico::scale_color_scico_d(palette = 'bamako', begin = .3, end = .7)
counts_adults_juveniles_2024 = read_csv('data/validation/2025_records-2311298/MOJN_IU_SOP15_Density_Data.csv', show_col_types = FALSE) %>%
filter(USDACode == 'YUBR')
View(counts_adults_2024)
View(counts_adults_juveniles_2015)
View(counts_adults_juveniles_2024)
counts_adults_juveniles_2024 = read_csv('data/validation/2025_records-2311298/MOJN_IU_SOP15_Density_Data.csv', show_col_types = FALSE)
View(counts_adults_juveniles_2024)
