'CNRM-ESM2-1' = 25,
'EC-Earth3-Veg' = 26,
'GFDL-ESM4' = 27,
'IPSL-CM6A-LR' = 28,
'MIROC6' = 29,
'MPI-ESM1-2-HR' = 30,
'MRI-ESM2-0' = 31,
'UKESM1-0-LL' = 32))
}
